{
        "name": "backend",
        "version": "1.0.0",
        "description": "Backend API with MySQL authentication and MongoDB orders",
        "main": "server.js",
        "scripts": {
                "start": "NODE_ENV=production node server.js",
                "dev": "NODE_ENV=development nodemon server.js",
                "test": "jest --coverage",
                "migrate": "node scripts/migrate.js",
                "seed": "node scripts/seed.js",
                "lint": "eslint .",
                "docker:build": "docker build -t backend-api .",
                "docker:up": "docker-compose up -d",
                "docker:down": "docker-compose down",
                "docker:logs": "docker-compose logs -f"
        },
        "dependencies": {
                "bcryptjs": "^3.0.3",
                "compression": "^1.7.4",
                "cookie-parser": "^1.4.6",
                "cors": "^2.8.5",
                "dotenv": "^16.0.3",
                "express": "^4.18.2",
                "express-rate-limit": "^6.10.0",
                "express-validator": "^7.0.1",
                "helmet": "^7.0.0",
                "jsonwebtoken": "^9.0.3",
                "mongodb": "^5.5.0",
                "mongoose": "^7.2.1",
                "morgan": "^1.10.0",
                "mysql2": "^3.2.0",
                "nodemailer": "^6.9.1",
                "socket.io": "^4.6.1",
                "uuid": "^9.0.1",
                "validator": "^13.9.0",
                "ws": "^8.19.0"
        },
        "devDependencies": {
                "eslint": "^8.41.0",
                "eslint-config-airbnb-base": "^15.0.0",
                "eslint-plugin-import": "^2.27.5",
                "jest": "^29.5.0",
                "nodemon": "^2.0.22",
                "supertest": "^6.3.3"
        },
        "engines": {
                "node": ">=18.0.0"
        }
}
