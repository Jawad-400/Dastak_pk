{
    "name": "backend",
    "version": "1.0.0",
    "description": "Backend API with MySQL authentication and MongoDB orders",
    "main": "server.js",
    "scripts": {
      "start": "NODE_ENV=production node server.js",
      "dev": "NODE_ENV=development nodemon server.js",
      "test": "jest --coverage",
      "migrate": "node scripts/migrate.js",
      "seed": "node scripts/seed.js",
      "lint": "eslint .",
      "docker:build": "docker build -t backend-api .",
      "docker:up": "docker-compose up -d",
      "docker:down": "docker-compose down",
      "docker:logs": "docker-compose logs -f"
    },
    "dependencies": {
      "express": "^4.18.2",
      "cors": "^2.8.5",
      "helmet": "^7.0.0",
      "morgan": "^1.10.0",
      "compression": "^1.7.4",
      "cookie-parser": "^1.4.6",
      "dotenv": "^16.0.3",
      "mysql2": "^3.2.0",
      "mongodb": "^5.5.0",
      "mongoose": "^7.2.1",
      "bcrypt": "^5.1.0",
      "jsonwebtoken": "^9.0.0",
      "uuid": "^9.0.0",
      "validator": "^13.9.0",
      "express-validator": "^7.0.1",
      "express-rate-limit": "^6.10.0",
      "nodemailer": "^6.9.1",
      "ws": "^8.13.0",
      "socket.io": "^4.6.1"
    },
    "devDependencies": {
      "nodemon": "^2.0.22",
      "jest": "^29.5.0",
      "supertest": "^6.3.3",
      "eslint": "^8.41.0",
      "eslint-config-airbnb-base": "^15.0.0",
      "eslint-plugin-import": "^2.27.5"
    },
    "engines": {
      "node": ">=18.0.0"
    }
  }